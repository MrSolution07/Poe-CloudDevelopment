@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center py-5">
    <div class="mb-3" aria-hidden="true">
        <i class="bi bi-shield-lock text-secondary" style="font-size: 3.5rem;"></i>
    </div>
    <h1 class="h2 fw-semibold mb-3">Access denied</h1>
    <p class="text-muted mb-4">You do not have permission to view this page. Please sign in with an authorised account.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-eventease-primary">Sign in</a>
</div>
